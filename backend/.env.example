# Copy to ``backend/.env`` or repository root ``.env`` (Settings also reads ``../.env``).
#
# Install (from repo root, with domain packages available):
#   pip install -r backend/requirements.txt
#   export PYTHONPATH="$(pwd)"
#   cd backend && uvicorn app.main:app --reload --host 0.0.0.0 --port 8000

ENV=development
APP_NAME=K.U.A. Backend
LOG_LEVEL=INFO

# Async SQLAlchemy URL (use ``asyncpg`` driver).
DATABASE_URL=postgresql+asyncpg://kua:kua@localhost:5432/kua

REDIS_URL=redis://localhost:6379/0

# Minimum 32 characters in production. Rotate aggressively if leaked.
JWT_SECRET=CHANGE_ME_IN_PRODUCTION_MIN_32_CHARS______

JWT_ACCESS_EXPIRE_MINUTES=30
JWT_REFRESH_EXPIRE_DAYS=14

# bcrypt hash for the operator account (never store plaintext passwords).
# Generate:
#   python -c "from passlib.context import CryptContext; print(CryptContext(schemes=['bcrypt'], deprecated='auto').hash('YOUR_PASSWORD'))"
OPERATOR_USERNAME=operator
OPERATOR_PASSWORD_HASH=

OPERATOR_DISPLAY_NAME=Acquisitions Operator
OPERATOR_CLEARANCE=tier-1

# Frontend origins for browser CORS (comma-separated). Vercel preview URLs count.
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Trusted ``Host`` headers (comma-separated). Include your API domain and Railway hostname.
# Development default appends ``*`` via settings to simplify Docker Desktop networking.
TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# HTTP-only auth cookies
COOKIE_ACCESS_NAME=kua_access_token
COOKIE_REFRESH_NAME=kua_refresh_token
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=.yourdomain.com   # Lax cross-subdomain if needed

# Rate limits (slowapi syntax)
RATE_LIMIT_DEFAULT=200/minute
RATE_LIMIT_AUTH=10/minute

# LLM (optional memo polish)
# AI_PROVIDER=openai  # openai | claude | local
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# WebSocket URL for Next.js (example)
# NEXT_PUBLIC_WS_URL=wss://api.yourdomain.com
