################################################################################
# K.U.A. — KLAVE URBAN AGENT — Frontend environment template
#
# Copy this to `.env.local` for local development.
# Set the same vars in Railway → kua-frontend → Variables for production.
################################################################################

# ----- BACKEND (REQUIRED) -----------------------------------------------------
# FastAPI base URL. Primary variable. Read by both server and edge runtimes.
# The frontend will hard-fall-back to the canonical K.U.A. backend if this
# is missing, but PLEASE set it explicitly.
NEXT_PUBLIC_API_URL=https://kua-urban-agent-production.up.railway.app

# Legacy alias — kept for backwards compatibility. Either variable works.
# BACKEND_API_URL=https://kua-urban-agent-production.up.railway.app

# Explicit login endpoint override. Leave blank — auto-derived as
# ${NEXT_PUBLIC_API_URL}/auth/login.
# BACKEND_AUTH_URL=

# ----- AUTH (REQUIRED) --------------------------------------------------------
# Signs the kua_session JWT cookie. Generate with:
#   openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-48-byte-random-string

# Cookie name + lifetime. Defaults are correct — change only if necessary.
AUTH_COOKIE_NAME=kua_session
AUTH_SESSION_TTL_SECONDS=43200   # 12h

# ----- DEV-ONLY break-glass operator (leave blank in production) --------------
# When NEXT_PUBLIC_API_URL is set the login route ALWAYS proxies to FastAPI
# and these are ignored. They only exist for offline development.
AUTH_OPERATOR_USERNAME=
AUTH_OPERATOR_PASSWORD_HASH=
AUTH_OPERATOR_DISPLAY_NAME=Acquisitions Operator
AUTH_OPERATOR_CLEARANCE=tier-1

# ----- DEPLOYMENT -------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=KLAVE URBAN AGENT
NEXT_PUBLIC_APP_SHORT=K.U.A.
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_WS_URL=
