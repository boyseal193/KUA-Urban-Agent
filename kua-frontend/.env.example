################################################################################
# K.U.A. — KLAVE URBAN AGENT
# Frontend environment template
#
# Copy this to `.env.local` for local development.
# Set the same vars in Railway → Variables for production.
################################################################################

# ----- BACKEND -----------------------------------------------------------------
# The FastAPI backend URL the SERVER calls (route handlers, RSC).
# In Railway, set this to the public URL of your FastAPI service.
BACKEND_API_URL=https://kua-urban-agent-production.up.railway.app

# Optional: explicit login endpoint. Defaults to ${BACKEND_API_URL}/auth/login
# Only override if your FastAPI mounts auth elsewhere.
# BACKEND_AUTH_URL=https://kua-urban-agent-production.up.railway.app/auth/login

# Optional public base URL exposed to the browser (only used for things like
# map tiles, never for secrets). Leave blank — the browser talks to the
# Next.js proxy at /api/proxy/* and never directly to FastAPI.
NEXT_PUBLIC_BACKEND_API_URL=

# ----- AUTHENTICATION ----------------------------------------------------------
# A long random string used to sign session JWTs. REQUIRED in production.
# Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-48-byte-random-string

# Cookie name + lifetime
AUTH_COOKIE_NAME=kua_session
AUTH_SESSION_TTL_SECONDS=43200   # 12h

# Optional local break-glass operator (DEV ONLY — leave empty in production).
# When BACKEND_API_URL is set, login proxies to FastAPI and these are ignored.
# Hash a password locally with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'YourPass'
AUTH_OPERATOR_USERNAME=
AUTH_OPERATOR_PASSWORD_HASH=
AUTH_OPERATOR_DISPLAY_NAME=Acquisitions Operator
AUTH_OPERATOR_CLEARANCE=tier-1

# ----- DEPLOYMENT --------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=KLAVE URBAN AGENT
NEXT_PUBLIC_APP_SHORT=K.U.A.
NEXT_PUBLIC_APP_VERSION=0.1.0

# ----- OPTIONAL: WEBSOCKETS ----------------------------------------------------
NEXT_PUBLIC_WS_URL=
