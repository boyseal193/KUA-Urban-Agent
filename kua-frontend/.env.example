################################################################################
# K.U.A. — KLAVE URBAN AGENT
# Frontend environment template
#
# Copy this to `.env.local` for local development.
# Set the same vars (without NEXT_PUBLIC_ prefix where applicable) in your
# Vercel / Railway / Render / Docker dashboard for production.
################################################################################

# ----- BACKEND -----------------------------------------------------------------
# The FastAPI backend URL the SERVER calls (Next.js Route Handlers, RSC).
# Use the private network URL in production where possible.
BACKEND_API_URL=http://127.0.0.1:8000

# Public BASE URL exposed to the browser (only used for things like map tiles,
# never for secret API keys). If your FastAPI is internet-reachable and you want
# the browser to call it directly, set this. Otherwise leave blank and the
# frontend will proxy through Next.js Route Handlers (recommended).
NEXT_PUBLIC_BACKEND_API_URL=

# ----- AUTHENTICATION ----------------------------------------------------------
# A long random string. Generate with: openssl rand -base64 48
AUTH_SECRET=replace-me-with-a-48-byte-random-string

# Cookie name + lifetime
AUTH_COOKIE_NAME=kua_session
AUTH_SESSION_TTL_SECONDS=43200   # 12h

# Demo operator credentials. In production replace with a real user store or
# proxy to the FastAPI /auth/login endpoint.
# Hash a password locally with:
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1],10))" 'YourPass'
AUTH_OPERATOR_USERNAME=operator
AUTH_OPERATOR_PASSWORD_HASH=$2a$10$EXAMPLEHASH___replace_me___EXAMPLEHASH
AUTH_OPERATOR_DISPLAY_NAME=Acquisitions Operator
AUTH_OPERATOR_CLEARANCE=tier-1

# ----- DEPLOYMENT --------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=KLAVE URBAN AGENT
NEXT_PUBLIC_APP_SHORT=K.U.A.
NEXT_PUBLIC_APP_VERSION=0.1.0

# ----- OPTIONAL: WEBSOCKETS ----------------------------------------------------
NEXT_PUBLIC_WS_URL=
